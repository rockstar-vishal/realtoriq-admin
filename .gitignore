# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*
# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

/app/assets/builds/*
!/app/assets/builds/.keep
.claude/*
tmp/*
.DS_Store

# Gemfile.lock and config/database.yml are deliberately NOT ignored.
# Both are required to deploy: the Dockerfile does `COPY Gemfile Gemfile.lock`,
# BUNDLE_DEPLOYMENT=1 refuses to run without a lockfile, and Rails cannot boot
# without database.yml. Neither holds a secret — database.yml reads host,
# username and password from the environment and emits them only when set.
