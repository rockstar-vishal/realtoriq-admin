# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle
credentials.yml.enc
# Ignore all environment files.
/.env*
# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

/app/assets/builds/*
!/app/assets/builds/.keep
.claude/*
tmp/*
.DS_Store
# Kept OUT of version control by decision. Both are provisioned per machine:
# database.yml is placed there as a deploy step, Gemfile.lock is regenerated
# by `bundle install`. Do not add either back without asking.
config/database.yml
Gemfile.lock

# Working notes, not codebase documentation. Dated write-ups that go stale, and
# the audit report lists findings that are not fixed yet — neither belongs in a
# repo that gets pushed. Kept on disk, shared by hand.
docs/audit-*.md
docs/tech-debt.md
