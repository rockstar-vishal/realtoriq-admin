<% content_for :title, "Firms · RealtorIQ Admin" %>

<div class="flex items-baseline gap-3 mb-6">
  <h1 class="text-[32px]">Firms</h1>
  <span class="text-[13px] text-[var(--color-neutral-600)]"><%= pluralize(@pagy.count, "firm") %></span>
  <%= link_to "New firm", new_admin_firm_path, class: "btn btn-primary ml-auto" %>
</div>

<hr class="rule">

<%= form_with url: admin_firms_path, method: :get, class: "flex flex-wrap items-end gap-4 mb-5" do |f| %>
  <div class="field w-[280px]">
    <%= f.label :q, "Search" %>
    <%= f.search_field :q, value: params[:q], class: "input",
          placeholder: "Name, code, mobile or email" %>
  </div>

  <div class="field w-[170px]">
    <%= f.label :status, "Status" %>
    <%= f.select :status,
          options_for_select(Firm::STATUSES.map { |s| [s.humanize, s] }, params[:status]),
          { include_blank: "All" }, class: "input" %>
  </div>

  <div class="field w-[190px]">
    <%= f.label :verification, "Verification" %>
    <%= f.select :verification,
          options_for_select([["All verified", "complete"], ["Something missing", "incomplete"]], params[:verification]),
          { include_blank: "Any" }, class: "input" %>
  </div>

  <%= f.submit "Filter", class: "btn btn-secondary" %>

  <% if params[:q].present? || params[:status].present? || params[:verification].present? %>
    <%= link_to "Clear", admin_firms_path, class: "btn btn-ghost" %>
  <% end %>
<% end %>

<% if @firms.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Firm</th>
        <th>Contact</th>
        <th>Verification</th>
        <th>Status</th>
        <th>Users</th>
        <th>Added</th>
      </tr>
    </thead>
    <tbody>
      <% @firms.each do |firm| %>
        <tr>
          <td>
            <div class="flex items-center gap-3">
              <% if firm.logo.attached? %>
                <%= image_tag firm.logo.variant(:thumb), class: "w-8 h-8 object-cover", alt: "" %>
              <% else %>
                <div class="w-8 h-8 bg-[var(--color-neutral-200)] grid place-items-center text-[11px] font-extrabold text-[var(--color-neutral-700)]">
                  <%= firm.name.to_s.first(2).upcase %>
                </div>
              <% end %>
              <div>
                <%= link_to firm.display_name, admin_firm_path(firm),
                      class: "no-underline font-heading font-extrabold text-[14px] text-[var(--color-ink)] hover:text-[var(--color-accent)]" %>
                <div class="text-[12px] text-[var(--color-neutral-600)]"><%= firm.code %></div>
              </div>
            </div>
          </td>

          <td class="text-[13px]">
            <div><%= blank_dash firm.primary_contact_name %></div>
            <div class="text-[var(--color-neutral-600)]">
              <%= blank_dash firm.contact_channels.find { |c| c.kind == "mobile" }&.display_value %>
            </div>
          </td>

          <td>
            <div class="flex gap-1">
              <% ContactChannel::KINDS.each do |kind| %>
                <% channel = firm.contact_channels.find { |c| c.kind == kind } %>
                <% if channel %>
                  <%= channel_tag(channel) %>
                <% else %>
                  <span class="tag tag-neutral opacity-50" title="<%= kind.humanize %>: not set">—</span>
                <% end %>
              <% end %>
            </div>
          </td>

          <td><%= firm_status_tag(firm) %></td>
          <td class="text-[13px]"><%= firm.users.size %></td>
          <td class="text-[13px] text-[var(--color-neutral-700)]"><%= firm.created_at.strftime("%d %b %Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @pagy.pages > 1 %>
    <div class="mt-6 text-[13px]"><%== pagy_nav(@pagy) %></div>
  <% end %>
<% else %>
  <div class="py-14">
    <p class="font-heading font-extrabold text-[18px] mb-2">No firms match</p>
    <p class="text-[14px] text-[var(--color-neutral-700)] mb-4">
      <%= params.values_at(:q, :status, :verification).any?(&:present?) ? "Try widening the filters." : "Create the first firm to get started." %>
    </p>
    <%= link_to "New firm", new_admin_firm_path, class: "btn btn-primary" %>
  </div>
<% end %>
