<p class="text-[13px] text-[var(--color-neutral-700)] mb-4 max-w-[640px]">
  The firm's three contact points. Verify them here, or let the firm's super admin do it from the
  app. Editing a channel's value clears its verification.
</p>

<hr class="rule mt-0">

<div id="contact_channels" class="max-w-[900px]">
  <% ContactChannel::KINDS.each do |kind| %>
    <% channel = channels.find { |c| c.kind == kind } %>

    <% if channel %>
      <%= render "admin/firms/channel_row", channel: channel, firm: firm %>
    <% else %>
      <div class="flex items-center gap-4 py-4 border-b border-[var(--color-divider)]">
        <div class="w-[110px] shrink-0 text-[11px] uppercase tracking-[0.08em] text-[var(--color-neutral-700)]">
          <%= kind.humanize %>
        </div>
        <div class="flex-1 text-[14px] text-[var(--color-neutral-600)]">Not set</div>
        <%= link_to "Add", edit_admin_firm_path(firm), class: "btn btn-ghost" %>
      </div>
    <% end %>
  <% end %>
</div>
