<% content_for :title, "Edit #{@plan.name} · RealtorIQ Admin" %>

<div class="mb-2">
  <%= link_to "← Plans", admin_plans_path, class: "text-[13px] no-underline text-[var(--color-neutral-700)] hover:text-[var(--color-accent)]" %>
</div>

<h1 class="text-[32px] mb-1">Edit plan</h1>
<p class="text-[13px] text-[var(--color-neutral-700)] mb-6">
  Changing the price affects new and renewed subscriptions only — existing ones keep the amount
  they were created with.
</p>

<hr class="rule">

<div class="max-w-[820px]">
  <%= render "form", plan: @plan, url: admin_plan_path(@plan), method: :patch, submit_label: "Save changes" %>
</div>

<% if @plan.subscriptions.across_firms.live.none? %>
  <section class="mt-10 max-w-[820px]">
    <hr class="rule">
    <%= button_to "Delete this plan", admin_plan_path(@plan), method: :delete,
          class: "btn btn-secondary",
          form: { data: { turbo_confirm: "Delete #{@plan.name}?" } } %>
  </section>
<% end %>
