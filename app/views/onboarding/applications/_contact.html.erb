<%#
  One contact: value → Send code → code + Verify → verified.
  Locals: kind ("mobile" | "whatsapp" | "email"), label, must_verify (Boolean).

  With JavaScript, signup-contact posts to the same three endpoints and gets
  JSON back, so nothing reloads and chosen files stay chosen. Without it, every
  button shows and posts the whole form to its formaction, as before.
%>
<% value = @form.public_send(kind) %>
<% state = @sitting.state(kind, value) %>
<% sent_at = @sitting.sent_at(kind) %>
<% resend_at = sent_at && sent_at + ContactChannel::RESEND_COOLDOWN %>
<% phone = kind != "email" %>
<% lower = kind == "whatsapp" ? "WhatsApp number" : label.downcase_first %>
<% sent_to = { "mobile" => "Enter the code sent by SMS to", "whatsapp" => "Enter the code sent on WhatsApp to", "email" => "Enter the code we emailed to" }[kind] %>
<% check_icon = '<svg class="su-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>'.html_safe %>

<div class="su-contact" id="contact-<%= kind %>" data-kind="<%= kind %>" data-label="<%= lower %>" data-state="<%= state %>"
     <%= "data-must-verify" if must_verify %>
     data-controller="signup-contact"
     data-signup-contact-kind-value="<%= kind %>"
     data-signup-contact-state-value="<%= state %>"
     data-signup-contact-send-url-value="<%= registration_send_code_path(kind:) %>"
     data-signup-contact-verify-url-value="<%= registration_verify_code_path(kind:) %>"
     data-signup-contact-change-url-value="<%= registration_change_contact_path(kind:) %>"
     data-signup-contact-resend-at-value="<%= resend_at&.iso8601 %>">
  <div class="su-contact-top">
    <label class="su-label" for="<%= kind %>"><%= label %> <span class="su-req" aria-hidden="true">*</span></label>
    <% if kind == "whatsapp" %>
      <label class="su-check su-check-sm">
        <input type="checkbox" data-signup-contact-target="same" data-action="change->signup-contact#sameAsMobile">Same as mobile
      </label>
    <% end %>
  </div>

  <div class="su-row">
    <% if phone %>
      <div class="su-prefixed su-grow">
        <span class="su-prefix">+91</span>
        <input class="su-input" type="tel" id="<%= kind %>" name="<%= kind %>" value="<%= signup_phone_digits(value) %>"
               inputmode="numeric" autocomplete="tel-national" maxlength="14" placeholder="98201 44210" required
               data-required data-missing="Enter your <%= lower %>."
               aria-invalid="<%= field_invalid(@form, kind.to_sym) %>" aria-describedby="<%= kind %>_error"
               data-signup-contact-target="value" data-action="input->signup-contact#valueInput keydown.enter->signup-contact#send">
      </div>
    <% else %>
      <div class="su-grow">
        <input class="su-input" type="email" id="<%= kind %>" name="<%= kind %>" value="<%= value %>"
               inputmode="email" autocomplete="email" maxlength="160" placeholder="you@yourfirm.com" required
               data-required data-missing="Enter your email address."
               aria-invalid="<%= field_invalid(@form, kind.to_sym) %>" aria-describedby="<%= kind %>_error"
               data-signup-contact-target="value" data-action="keydown.enter->signup-contact#send">
      </div>
    <% end %>
    <button type="submit" class="su-btn su-send" formaction="<%= registration_send_code_path(kind:) %>" formnovalidate
            data-signup-contact-target="send" data-action="signup-contact#send">Send code</button>
  </div>

  <p class="su-state-line">
    <span class="su-verified"><%= check_icon %>Verified</span>
    <button type="submit" class="su-link su-change" formaction="<%= registration_change_contact_path(kind:) %>" formnovalidate
            data-action="signup-contact#change">Change</button>
  </p>

  <% if kind == "whatsapp" %>
    <p class="su-contact-optional">Verifying WhatsApp is optional now. You can do it later in the app.</p>
  <% end %>

  <div class="su-code">
    <p class="su-code-label">
      <%= sent_to %> <strong data-signup-contact-target="sentTo"><%= signup_contact_display(kind, value) %></strong><span class="su-change"> · <button type="submit" class="su-link" formaction="<%= registration_change_contact_path(kind:) %>" formnovalidate data-action="signup-contact#change">Change</button></span>
    </p>
    <div class="su-row">
      <input class="su-otp" type="text" id="<%= kind %>_code" name="<%= kind %>_code" inputmode="numeric" autocomplete="one-time-code"
             maxlength="6" placeholder="••••••" aria-label="6-digit code"
             data-signup-contact-target="code" data-action="input->signup-contact#codeInput keydown.enter->signup-contact#verify">
      <button type="submit" class="su-btn" formaction="<%= registration_verify_code_path(kind:) %>" formnovalidate
              data-signup-contact-target="verify" data-action="signup-contact#verify">Verify</button>
    </div>
    <p class="su-code-meta">
      <button type="submit" class="su-link" formaction="<%= registration_send_code_path(kind:) %>" formnovalidate
              data-signup-contact-target="resend" data-action="signup-contact#send">Resend code</button>
      <span data-signup-contact-target="timer"></span>
      <span>Codes work for 10 minutes.<%= " Check spam if it isn't in your inbox." if kind == "email" %></span>
    </p>
  </div>

  <p class="su-msg" data-signup-contact-target="message" role="status" aria-live="polite"></p>
  <%= field_error(@form, kind.to_sym) %>
</div>
